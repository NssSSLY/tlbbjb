# Development sources stay editable. Runtime gets one uncompressed resource file.
file(GLOB_RECURSE tlbb_assets CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/scripts/*")
list(FILTER tlbb_assets EXCLUDE REGEX "/(user|__pycache__|\\.git)/")
# Extracted bytecode shards stay in the project as evidence; tasks run scripts/original-source instead.
list(FILTER tlbb_assets EXCLUDE REGEX "/scripts/original-library/[^/]+\\.bin$")
list(APPEND tlbb_assets "${CMAKE_CURRENT_SOURCE_DIR}/design/task-catalog.json")
list(SORT tlbb_assets)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${tlbb_assets})
set(tlbb_qrc "<RCC>\n<qresource prefix=\"/tlbb\">\n")
set(tlbb_index "{\"schema\":1,\"kind\":\"tlbb_resources\",\"version\":\"${PROJECT_VERSION}\",\"compressed\":false,\"files\":[")
set(tlbb_comma "")
foreach(tlbb_file IN LISTS tlbb_assets)
  if(IS_DIRECTORY "${tlbb_file}")
    continue()
  endif()
  if(tlbb_file STREQUAL "${CMAKE_CURRENT_SOURCE_DIR}/design/task-catalog.json")
    set(tlbb_alias "tasks/catalog.json")
  else()
    file(RELATIVE_PATH tlbb_relative "${CMAKE_CURRENT_SOURCE_DIR}/scripts" "${tlbb_file}")
    set(tlbb_alias "scripts/builtin/${tlbb_relative}")
  endif()
  file(SIZE "${tlbb_file}" tlbb_bytes)
  file(SHA256 "${tlbb_file}" tlbb_hash)
  string(REPLACE "&" "&amp;" tlbb_xml "${tlbb_file}")
  string(REPLACE "<" "&lt;" tlbb_xml "${tlbb_xml}")
  string(APPEND tlbb_qrc "<file alias=\"${tlbb_alias}\">${tlbb_xml}</file>\n")
  string(APPEND tlbb_index "${tlbb_comma}{\"path\":\"${tlbb_alias}\",\"bytes\":${tlbb_bytes},\"sha256\":\"${tlbb_hash}\"}")
  set(tlbb_comma ",")
endforeach()
string(APPEND tlbb_index "]}\n")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/assets-manifest.json" "${tlbb_index}")
string(APPEND tlbb_qrc "<file alias=\"assets-manifest.json\">${CMAKE_CURRENT_BINARY_DIR}/assets-manifest.json</file>\n</qresource>\n</RCC>\n")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/builtin-assets.qrc" "${tlbb_qrc}")
add_custom_command(OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/TLBBData.rcc"
  COMMAND $<TARGET_FILE:Qt6::rcc> --binary --no-compress "${CMAKE_CURRENT_BINARY_DIR}/builtin-assets.qrc" -o "${CMAKE_CURRENT_BINARY_DIR}/TLBBData.rcc"
  DEPENDS ${tlbb_assets} "${CMAKE_CURRENT_BINARY_DIR}/assets-manifest.json" "${CMAKE_CURRENT_BINARY_DIR}/builtin-assets.qrc"
  VERBATIM)
add_custom_target(TLBBData ALL DEPENDS "${CMAKE_CURRENT_BINARY_DIR}/TLBBData.rcc")
add_dependencies(TLBB TLBBData)
